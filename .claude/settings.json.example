{
  "_comment": "Illustrative. `uv run skill-router install-hook --write` generates this with the absolute path of this checkout's virtualenv filled in.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "<path-to-skill-router>/.venv/bin/skill-router session-start",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
